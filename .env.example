# Copy this file to .env and fill in your real values
# .env is git-ignored — never commit it
# Used by docker-compose automatically

MYSQL_ROOT_PASSWORD=your_mysql_password_here
HAWK_JWT_SECRET=your_long_random_jwt_secret_min_32_chars
HAWK_ADMIN_USERNAME=admin
HAWK_ADMIN_PASSWORD=your_admin_password_here
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password_here

