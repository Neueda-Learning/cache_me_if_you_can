{
  "info": {
    "name": "HAWK - External Transaction Alert Simulation",
    "_postman_id": "2f6c95fb-3b6d-47f5-8e5f-8f0e43d7d2f2",
    "description": "Use this collection to simulate transactions from outside the UI and trigger alerts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "const token = json && json.data ? json.data.token : null;",
              "pm.test('Token present', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('jwt', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Transaction - THRESHOLD",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": {{account2Id}},\n  \"payeeId\": {{payeeAId}},\n  \"amount\": 12000,\n  \"transactionType\": \"TRANSFER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Create Transaction - NEW_PAYEE",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": {{account2Id}},\n  \"payeeId\": {{payeeBId}},\n  \"amount\": 1000,\n  \"transactionType\": \"PAYMENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Create Transaction - VELOCITY (Run 3x quickly)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": {{account2Id}},\n  \"payeeId\": {{payeeAId}},\n  \"amount\": 500,\n  \"transactionType\": \"PAYMENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Create Transaction - DAILY_LIMIT (exceed day cap)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": {{account2Id}},\n  \"payeeId\": {{payeeAId}},\n  \"amount\": 15000,\n  \"transactionType\": \"TRANSFER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Alerts - All",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/alerts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "alerts"]
        }
      }
    },
    {
      "name": "Alerts - Grouped (Last 60 min)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/alerts/grouped?minutes=60",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "alerts", "grouped"],
          "query": [
            { "key": "minutes", "value": "60" }
          ]
        }
      }
    },
    {
      "name": "Alerts - Grouped HIGH (Last 60 min)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/alerts/grouped?minutes=60&severity=HIGH",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "alerts", "grouped"],
          "query": [
            { "key": "minutes", "value": "60" },
            { "key": "severity", "value": "HIGH" }
          ]
        }
      }
    },
    {
      "name": "Account #2 Transactions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/account/{{account2Id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "account", "{{account2Id}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "Admin@1234" },
    { "key": "jwt", "value": "" },
    { "key": "account2Id", "value": "2" },
    { "key": "payeeAId", "value": "1" },
    { "key": "payeeBId", "value": "2" }
  ]
}

