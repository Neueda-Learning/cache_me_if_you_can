# -----------------------------------------------------------------------------
# Copy this file to application.properties and fill in your local values.
# Never commit real credentials to the repository.
# -----------------------------------------------------------------------------

spring.application.name=transaction_monitor

# -- MySQL datasource ----------------------------------------------------------
# Replace YOUR_HOST, YOUR_PORT, and YOUR_DB_NAME as needed.
# createDatabaseIfNotExist=true lets Spring create the schema database on first run.
spring.datasource.url=jdbc:mysql://YOUR_HOST:3306/transaction_monitoring?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# -- SQL schema initialization -------------------------------------------------
# 'always' runs schema.sql every startup (safe — all statements use IF NOT EXISTS).
# Change to 'never' once the schema is stable and you want to manage it manually.
spring.sql.init.mode=always
spring.sql.init.schema-locations=classpath:schema.sql

# -- JWT ----------------------------------------------------------------------
hawk.jwt.secret=YOUR_LONG_RANDOM_JWT_SECRET
hawk.jwt.expiry-hours=24

# -- Seeded admin account ------------------------------------------------------
hawk.admin.username=YOUR_ADMIN_USERNAME
hawk.admin.password=YOUR_ADMIN_PASSWORD
hawk.admin.fullname=System Administrator

# -- Email --------------------------------------------------------------------
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_SMTP_USERNAME
spring.mail.password=YOUR_SMTP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.debug=false
logging.level.org.springframework.mail=INFO

